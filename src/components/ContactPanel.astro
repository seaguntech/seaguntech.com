---
import { contact } from '../content/site';
---

<section class="contact-panel section-dark" id="contact" aria-labelledby="contact-title">
  <div class="container contact-grid">
    <div>
      <p class="eyebrow">Start with a conversation</p>
      <h2 id="contact-title">Have a complex idea? Let’s make it dependable.</h2>
    </div>
    <div class="contact-actions">
      <a class="button" href={contact.consultationHref}>Book a consultation <span aria-hidden="true">↗</span></a>
      <a class="email-link" href={`mailto:${contact.email}`}>{contact.email}</a>
    </div>
  </div>
</section>
