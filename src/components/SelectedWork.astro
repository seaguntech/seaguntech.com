---
import { selectedProjects } from '../content/site';
---

<section class="section" id="work" aria-labelledby="work-title">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">Selected work</p>
      <h2 id="work-title">A track record built in public.</h2>
      <p>Selected projects from the founder’s public portfolio.</p>
    </div>
    <div class="work-grid">
      {selectedProjects.map((project, index) => (
        <article class="work-card">
          <div class="work-card-topline">
            <span class="card-index">0{index + 1}</span>
            <span class="work-label">Public project</span>
          </div>
          <h3>{project.title}</h3>
          <p>{project.description}</p>
          <div class="tag-list" aria-label={`${project.title} technologies`}>
            {project.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
          {project.href && (
            <a class="text-link" href={project.href} target="_blank" rel="noreferrer">
              View project <span aria-hidden="true">↗</span>
            </a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
