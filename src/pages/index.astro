---
import SiteNav from '../components/SiteNav.astro';
import Hero from '../components/Hero.astro';
import ExperienceSignal from '../components/ExperienceSignal.astro';
import Services from '../components/Services.astro';
import PlanningProcess from '../components/PlanningProcess.astro';
import SelectedWork from '../components/SelectedWork.astro';
import EngineeringFoundations from '../components/EngineeringFoundations.astro';
import FounderNote from '../components/FounderNote.astro';
import ContactPanel from '../components/ContactPanel.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

const title = 'Seaguntech | International technology consulting';
const description =
  'Seaguntech helps ambitious teams turn complex ideas into dependable software.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <SiteNav />
    <main id="main-content">
      <Hero />
      <ExperienceSignal />
      <Services />
      <PlanningProcess />
      <SelectedWork />
      <EngineeringFoundations />
      <FounderNote />
      <ContactPanel />
    </main>
    <SiteFooter />
  </body>
</html>
